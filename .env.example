NODE_ENV=dev

#auth
JWT_SECRET=T2zDrXZpYQ

#database
DATABASE_URL="postgresql://docker:docker@localhost:5432/metrics?schema=public"
# Publicacao de releases (instaladores/APKs). Chave dedicada; gere uma longa e guarde no cofre de senhas.
RELEASE_UPLOAD_KEY=
# Enquanto nao for "false", as chaves antigas ainda publicam (transicao). Depois de testar a nova, defina false.
RELEASE_ALLOW_LEGACY_KEYS=true

# Acompanhamento do cancelamento do iFood (/delivery/ifood/diag). Invente uma senha longa; sem ela a página fica desativada.
# Gerar: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
IFOOD_DIAG_KEY=

# 99Food (Portal do desenvolvedor > Gerenciamento de aplicativo). Segredo do app: nunca colocar no código.
# FOOD99_SECRET tambem valida a assinatura (didi-header-sign) dos webhooks recebidos.
FOOD99_APP_ID=
FOOD99_SECRET=
